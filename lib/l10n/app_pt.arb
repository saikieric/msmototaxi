{
  "@@locale": "pt",

  "appTitlePassenger": "MotoGo",
  "@appTitlePassenger": {
    "description": "App/window title for the passenger flavor. Brand name — kept the same across languages on purpose."
  },
  "appTitleDriver": "MotoGo Motorista",
  "@appTitleDriver": {
    "description": "App/window title for the driver flavor."
  },

  "logoutTooltip": "Sair",
  "@logoutTooltip": {
    "description": "Tooltip on the logout icon button, shown on both home screens."
  },

  "languageSwitcherTooltip": "Idioma",
  "@languageSwitcherTooltip": {
    "description": "Tooltip on the language-switcher icon button."
  },
  "languageOptionSystem": "Automático (idioma do dispositivo)",
  "@languageOptionSystem": {
    "description": "Menu option: follow the device's language setting instead of a manually picked one."
  },

  "loginPassengerSubtitle": "Aplicativo do passageiro",
  "@loginPassengerSubtitle": {
    "description": "Subtitle under the app name on the login screen, passenger flavor."
  },
  "loginDriverSubtitle": "Aplicativo do motorista",
  "@loginDriverSubtitle": {
    "description": "Subtitle under the app name on the login screen, driver flavor."
  },
  "loginButton": "Entrar",
  "@loginButton": {
    "description": "Login screen's submit button — creates an anonymous Supabase session, see AuthRepository.signInAnonymously."
  },
  "loginFailedMessage": "Falha ao entrar: {error}",
  "@loginFailedMessage": {
    "description": "Snackbar shown when signInAnonymously fails (e.g. no network, backend unreachable).",
    "placeholders": {
      "error": {
        "type": "String",
        "description": "The underlying exception's string representation."
      }
    }
  },
  "loginNotConnectedMessage": "Não conectado ao servidor. Configure o backend para continuar.",
  "@loginNotConnectedMessage": {
    "description": "Snackbar shown on the login button when SupabaseConfig.isConfigured is false (.env still has placeholder values), instead of attempting signInAnonymously."
  },

  "passengerGettingCurrentLocation": "Obtendo localização atual…",
  "@passengerGettingCurrentLocation": {
    "description": "Banner shown while fetching the device's GPS position for the pickup point."
  },
  "passengerLocationServiceDisabled": "O serviço de localização está desativado",
  "@passengerLocationServiceDisabled": {
    "description": "Error shown when the device's location service (GPS) itself is off."
  },
  "passengerLocationPermissionDenied": "A permissão de localização não foi concedida",
  "@passengerLocationPermissionDenied": {
    "description": "Error shown when the app doesn't have location permission."
  },
  "passengerLocationFetchFailed": "Falha ao obter a localização atual: {error}",
  "@passengerLocationFetchFailed": {
    "description": "Error shown for any other failure while fetching the device's GPS position.",
    "placeholders": {
      "error": {
        "type": "String",
        "description": "The underlying exception's string representation."
      }
    }
  },
  "passengerTapMapToPickPickupHint": "Você também pode tocar no mapa para escolher o ponto de embarque.",
  "@passengerTapMapToPickPickupHint": {
    "description": "Appended to a location error banner, telling the user they can still pick a pickup point manually."
  },
  "passengerPickupMarkerTitle": "Ponto de embarque",
  "@passengerPickupMarkerTitle": {
    "description": "Info-window title on the pickup map marker."
  },
  "passengerDropoffMarkerTitle": "Ponto de desembarque",
  "@passengerDropoffMarkerTitle": {
    "description": "Info-window title on the dropoff map marker."
  },
  "passengerBackToPickupTooltip": "Voltar ao ponto de embarque",
  "@passengerBackToPickupTooltip": {
    "description": "Tooltip on the small FAB that re-centers the map on the pickup point."
  },
  "passengerPickupNotSet": "Ponto de embarque: não definido",
  "@passengerPickupNotSet": {
    "description": "Status line shown before a pickup point is set."
  },
  "passengerPickupSet": "Ponto de embarque: definido",
  "@passengerPickupSet": {
    "description": "Status line shown once a pickup point is set."
  },
  "passengerPickupRadiusHint": "Arraste o pino dentro do círculo para ajustar o ponto de embarque",
  "@passengerPickupRadiusHint": {
    "description": "Small caption shown under the pickup status line once the device's GPS location is known, explaining the draggable-within-radius circle drawn on the map."
  },
  "passengerDropoffNotSet": "Ponto de desembarque: toque no mapa para selecionar",
  "@passengerDropoffNotSet": {
    "description": "Status line shown before a dropoff point is set."
  },
  "passengerDropoffSet": "Ponto de desembarque: definido",
  "@passengerDropoffSet": {
    "description": "Status line shown once a dropoff point is set."
  },
  "passengerRequestRideButton": "Solicitar corrida",
  "@passengerRequestRideButton": {
    "description": "Button that inserts a rides row with status requested."
  },
  "passengerCancelRideButton": "Cancelar solicitação",
  "@passengerCancelRideButton": {
    "description": "Button that sets the current requested ride to cancelled."
  },
  "passengerRideStatusRequested": "Corrida: solicitada",
  "@passengerRideStatusRequested": {
    "description": "Status line while the passenger's ride is requested and waiting for a driver."
  },
  "passengerRideStatusMatched": "Corrida: motorista encontrado",
  "@passengerRideStatusMatched": {
    "description": "Status line when a driver has been assigned to the ride."
  },
  "passengerRideStatusEnRoute": "Corrida: motorista a caminho",
  "@passengerRideStatusEnRoute": {
    "description": "Status line while the driver is heading to the pickup point."
  },
  "passengerRideStatusInProgress": "Corrida: em andamento",
  "@passengerRideStatusInProgress": {
    "description": "Status line while the passenger is on the trip."
  },
  "passengerRideStatusCompleted": "Corrida: concluída",
  "@passengerRideStatusCompleted": {
    "description": "Status line after the ride finishes normally."
  },
  "passengerRideStatusCancelled": "Corrida: cancelada",
  "@passengerRideStatusCancelled": {
    "description": "Status line after the passenger cancels a requested ride."
  },
  "passengerRequestRideNoSession": "Não há uma sessão ativa. Entre novamente.",
  "@passengerRequestRideNoSession": {
    "description": "Snackbar when the request button is tapped without a signed-in Supabase user."
  },
  "passengerRequestRideError": "Não foi possível solicitar a corrida: {error}",
  "@passengerRequestRideError": {
    "description": "Snackbar when inserting the ride or loading the current one fails.",
    "placeholders": {
      "error": {
        "type": "String",
        "description": "PostgrestException message or other error text."
      }
    }
  },
  "passengerCancelRideError": "Não foi possível cancelar a corrida: {error}",
  "@passengerCancelRideError": {
    "description": "Snackbar when cancelling the requested ride fails.",
    "placeholders": {
      "error": {
        "type": "String",
        "description": "PostgrestException message or other error text."
      }
    }
  },

  "driverOnlineStatus": "Online (recebendo solicitações)",
  "@driverOnlineStatus": {
    "description": "Status line shown when the driver has toggled themself online."
  },
  "driverOfflineStatus": "Offline",
  "@driverOfflineStatus": {
    "description": "Status line shown when the driver is offline."
  },
  "driverWaitingForRequests": "Aguardando solicitações…",
  "@driverWaitingForRequests": {
    "description": "Center-of-screen message shown while online with no incoming request."
  },
  "driverGoOnlineToReceiveRequests": "Fique online para receber solicitações",
  "@driverGoOnlineToReceiveRequests": {
    "description": "Center-of-screen message shown while offline."
  },
  "driverNavigateWithWazeTooltip": "Navegar com Waze",
  "@driverNavigateWithWazeTooltip": {
    "description": "Tooltip on the AppBar icon button for Waze navigation. Currently always shows driverNavigateWithWazeStubMessage on tap — see DriverHomeScreen, there's no assigned ride/pickup coordinate to navigate to yet since ride matching isn't implemented."
  },
  "driverNavigateWithWazeStubMessage": "A navegação pelo Waze ficará disponível assim que uma corrida for aceita (o pareamento de corridas ainda está em desenvolvimento).",
  "@driverNavigateWithWazeStubMessage": {
    "description": "Snackbar shown when tapping the (currently stubbed, no ride data yet) Waze navigation button on the driver screen."
  }
}
