# Supabase project settings (São Paulo region recommended per slides.md).
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Get these from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Google Maps API key, from Google Cloud Console > APIs & Services >
# Credentials (enable "Maps JavaScript API" / "Maps SDK for Android" as
# needed). Used by tool/gen_web_index.sh to generate web/index.html, and
# read directly by android/local.properties for the Android build.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
